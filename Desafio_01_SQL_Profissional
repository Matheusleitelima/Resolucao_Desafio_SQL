USE AtlasGlobal;
GO


-- =====================================================================
-- 1) Quantos pedidos a empresa já recebeu, e quantos desses pedidos
--    foram cancelados?
--    Dica: use WHERE para separar os cancelados. Tabela: pedidos.
-- =====================================================================

SELECT *
FROM pedidos

SELECT 
COUNT(id_pedido) AS QuantidadePedido
FROM pedidos

SELECT COUNT(id_pedido) AS Pedidos_cancelados
FROM pedidos
WHERE status = 'cancelado'



-- =====================================================================
-- 2) Qual o ticket médio (valor médio por pedido) dos pedidos em reais
--    (BRL), considerando só os pedidos não cancelados e não pendentes?
--    Dica: WHERE (moeda + status) + AVG. Tabela: pedidos.
-- =====================================================================
SELECT 
AVG(valor_total) AS TicketMedio
FROM pedidos
WHERE codigo_moeda = 'BRL' AND status = 'entregue'



-- =====================================================================
-- 3) Considerando só os pedidos em reais (BRL), qual o valor médio dos
--    pedidos de cada canal de venda (id_canal), e qual canal tem mais
--    pedidos no total?
--    Dica: WHERE codigo_moeda = 'BRL' + GROUP BY id_canal, com COUNT e AVG
--    na mesma consulta.
--    Tabela: pedidos.
-- =====================================================================
SELECT id_canal,
COUNT(id_pedido) AS total_pedidos,
AVG(valor_total) AS valor_medio
FROM pedidos
WHERE codigo_moeda = 'BRL'
GROUP BY id_canal
ORDER BY total_pedidos DESC

-- =====================================================================
-- 4) Qual método de pagamento é o mais usado (maior quantidade de
--    pagamentos) e qual movimenta mais dinheiro (maior soma)?
--    Considere só pagamentos com status 'aprovado'.
--    Dica: WHERE status_pagamento = 'aprovado' + GROUP BY metodo_pagamento.
--    Tabela: pagamentos.
-- =====================================================================
SELECT metodo_pagamento,
COUNT(id_pagamento) as ContagemPagamentos,
SUM(valor) as Valor_total
FROM pagamentos
WHERE status_pagamento = 'aprovado'
GROUP BY metodo_pagamento
ORDER BY ContagemPagamentos DESC 

SELECT metodo_pagamento,
COUNT(id_pagamento) as ContagemPagamentos,
SUM(valor) as Valor_total
FROM pagamentos
WHERE status_pagamento = 'aprovado'
GROUP BY metodo_pagamento
ORDER BY Valor_total DESC 



-- =====================================================================
-- 5) A nota média de satisfação (NPS) está subindo ou caindo, ano a ano?
--    Dica: GROUP BY usando YEAR(data_resposta). Tabela: pesquisas_nps.
-- =====================================================================
SELECT YEAR(data_resposta) AS ano,
SUM(nota) as nota_total
FROM pesquisas_nps
GROUP BY YEAR(data_resposta)
ORDER BY nota_total DESC



-- =====================================================================
-- 6) Quantos pedidos cada status representa (entregue, cancelado,
--    devolvido, em_transporte, pendente)?
--    Dica: GROUP BY status + COUNT(*). Tabela: pedidos.
-- =====================================================================

SELECT status,
COUNT(id_pedido) as TOTAL_PEDIDOS
FROM pedidos
GROUP BY status
ORDER BY TOTAL_PEDIDOS DESC


-- =====================================================================
-- 7) Quais clientes já fizeram 8 pedidos ou mais?
--    Dica: GROUP BY id_cliente + HAVING COUNT(*) >= 8. Tabela: pedidos.
-- =====================================================================
SELECT id_cliente,
COUNT(id_pedido) as Total_pedidos
FROM pedidos
GROUP BY id_cliente
HAVING COUNT(*) >= 8
ORDER BY Total_pedidos DESC


