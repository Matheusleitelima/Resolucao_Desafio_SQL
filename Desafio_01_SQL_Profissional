-- =====================================================================
-- 8) Existe algum produto que praticamente não vende? Liste os produtos
--    que venderam MENOS DE 30 UNIDADES no total, somando todos os
--    pedidos.
--    Dica: GROUP BY id_produto, somando a quantidade, e use HAVING
--    para aplicar o corte de 30 unidades. Tabela: itens_pedido.
-- =====================================================================

SELECT id_produto,
SUM(quantidade) as Quantidade_vendas
FROM itens_pedido
GROUP BY id_produto
HAVING SUM(quantidade) < 30






-- =====================================================================
-- 9) Quais moedas (codigo_moeda) têm salário médio acima de 3.000
--    (considerando a tabela de remuneração inteira, sem filtrar por
--    data), e que também tenham pelo menos 5 registros de remuneração
--    (para não deixar uma moeda com pouquíssimos registros distorcer
--    a média)?
--    Dica: GROUP BY codigo_moeda, com AVG(salario_mensal) e COUNT(*)
--    juntos. No HAVING, combine as duas condições com AND.
--    Tabela: remuneracao.
-- =====================================================================


SELECT codigo_moeda,
AVG(salario_mensal) as Media_salario
FROM remuneracao
GROUP BY codigo_moeda
HAVING AVG(salario_mensal) > 3000 AND count(*) >=5 


-- =====================================================================
-- 10) Quais centros de custo (id_centro_custo) tiveram um gasto médio
--     por despesa ACIMA DE 3.000 dólares, considerando apenas os
--     centros de custo com PELO MENOS 300 despesas registradas (para
--     não deixar um centro de custo com poucos lançamentos distorcer
--     a média)?
--     Dica: GROUP BY id_centro_custo, com AVG(valor_usd) e COUNT(*)
--     juntos. No HAVING, combine as duas condições com AND.
--     Tabela: despesas.
-- =====================================================================



SELECT id_centro_custo,
AVG(valor_usd) as Media_despesa
FROM despesas
GROUP BY id_centro_custo
HAVING AVG(valor_usd) > 3000 and COUNT(*) >= 300
